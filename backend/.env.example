# MongoDB Connection String
# Replace with your actual MongoDB connection string
# Example: mongodb://localhost:27017/woosh
# Or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/woosh?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/woosh

# Server Port
PORT=5000

# JWT Secret (for authentication)
# Generate a secure random string for production
JWT_SECRET=your-secret-key-change-this-in-production

# 2Factor OTP settings
# Keep this secret and set real key in backend/.env
TWOFACTOR_API_KEY=your-2factor-api-key
# Optional override; default is https://2factor.in/API/V1
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
# Optional if your 2Factor account uses a DLT approved template
# TWOFACTOR_TEMPLATE_NAME=YourTemplateName
# Optional full send path template (without base URL and API key).
# Supports {phone}, {otpLength}, {templateName}
# Example (non-DLT): TWOFACTOR_SEND_OTP_PATH_TEMPLATE=SMS/{phone}/AUTOGEN/{otpLength}
# Example (template): TWOFACTOR_SEND_OTP_PATH_TEMPLATE=SMS/{phone}/AUTOGEN/OTP1
# TWOFACTOR_SEND_OTP_PATH_TEMPLATE=SMS/{phone}/AUTOGEN/{otpLength}
# OTP settings
OTP_LENGTH=6
OTP_VALIDITY_MINUTES=10

# Cloudflare R2 (S3-compatible). When all are set, media uploads use R2 + public URLs; otherwise local /uploads/media.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://xxxx.r2.dev
# Optional override (default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
